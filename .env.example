# Copy to .env and replace every value. Generate secrets with: openssl rand -base64 32

# Frontend: signs the browser session cookie (comma-separated to rotate, newest first).
SESSION_SECRET=change-me-at-least-32-characters-long

# Shared by all services: signs tenant tokens (identity issues, others verify).
JWT_SECRET=change-me-at-least-32-characters-long
# Shared by all services: authenticates service-to-service calls.
INTERNAL_TOKEN=change-me-at-least-32-characters-long

# One Django secret per service.
IDENTITY_SECRET_KEY=change-me
OPERATIONS_SECRET_KEY=change-me
BILLING_SECRET_KEY=change-me

# Postgres (one database per service is created on first start).
POSTGRES_USER=tenantly
POSTGRES_PASSWORD=change-me
