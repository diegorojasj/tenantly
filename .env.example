# Copy to .env and replace every value. Generate secrets with: openssl rand -base64 32

# Frontend: signs the browser session cookie (comma-separated to rotate, newest first).
SESSION_SECRET=change-me-at-least-32-characters-long

# Frontend: the Locations map's tiles and credit (baked in at build). The default,
# OpenStreetMap's own tiles, is for development only — use a tile provider in production.
# VITE_MAP_TILES=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors

# Shared by all services: signs tenant tokens (identity issues, others verify).
JWT_SECRET=change-me-at-least-32-characters-long
# Identity only: signs Tenantly admin tokens. Must differ from JWT_SECRET.
ADMIN_JWT_SECRET=change-me-at-least-32-characters-long-and-different
# Minutes `manage.py activate_admin` / `create_admin` open an admin's access window for.
ADMIN_WINDOW_MINUTES=10
# The admin console's host (served only there, by the same proxy): http://admin.localhost:8080
ADMIN_HOST=admin.localhost
# Shared by all services: authenticates service-to-service calls.
INTERNAL_TOKEN=change-me-at-least-32-characters-long

# One Django secret per service.
IDENTITY_SECRET_KEY=change-me
OPERATIONS_SECRET_KEY=change-me
BILLING_SECRET_KEY=change-me

# Postgres (one database per service is created on first start).
POSTGRES_USER=tenantly
POSTGRES_PASSWORD=change-me

# Where the app is served (Stripe Checkout may only send owners back here).
APP_URL=http://localhost:8080
# Optional: card payments for Tenantly invoices. Unset = invoices are paid by transfer and
# recorded by staff (manage.py mark_paid). Webhook endpoint: <APP_URL>/api/billing/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
