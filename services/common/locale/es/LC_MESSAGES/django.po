#: api.py:27 auth.py:286
msgid "Sign in to continue"
msgstr "Inicia sesión para continuar"

#: api.py:33
msgid "invalid value"
msgstr "valor no válido"

#: auth.py:120
#, python-format
msgid "Your role can't do this (%(permission)s)"
msgstr "Tu rol no puede hacer esto (%(permission)s)"

#: auth.py:125
msgid "Your role doesn't use this page"
msgstr "Tu rol no usa esta página"

#: auth.py:163
msgid "Pick a location inside your scope"
msgstr "Elige una ubicación dentro de tu alcance"

#: auth.py:207
msgid "Your Tenantly invoice is overdue: pay it to add new customers again"
msgstr ""
"Tu factura de Tenantly está vencida: págala para volver a añadir clientes "
"nuevos"

#: auth.py:209
msgid "Your Tenantly invoice is overdue: pay it to take new bookings again"
msgstr ""
"Tu factura de Tenantly está vencida: págala para volver a aceptar reservas "
"nuevas"

#: auth.py:245
msgid "Your session expired — sign in again"
msgstr "Tu sesión expiró — vuelve a iniciar sesión"

#: auth.py:270
msgid ""
"Tenantly has restricted your account: you can look, but not change anything"
msgstr "Tenantly restringió tu cuenta: puedes consultar, pero no cambiar nada"

#: auth.py:278
msgid "This workspace is read-only: its Tenantly plan has ended"
msgstr "Este espacio es de solo lectura: su plan de Tenantly terminó"

#: auth.py:322 auth.py:325
msgid "Your admin session ended — sign in again"
msgstr "Tu sesión de administración terminó — vuelve a iniciar sesión"

#: internal.py:74
#, python-format
msgid "The %(service)s service is unavailable — try again in a moment"
msgstr ""
"El servicio de %(service)s no está disponible — inténtalo de nuevo en un "
"momento"

#: internal.py:82
#, python-format
msgid "The %(service)s service sent an unreadable answer"
msgstr "El servicio de %(service)s envió una respuesta ilegible"

#: internal.py:85
msgid "Request failed"
msgstr "La solicitud falló"
